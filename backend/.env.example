# ─── 必須 ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./memorial.db
SECRET_KEY=dev-secret-key-change-in-production
BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── ファイルアップロード先 ───────────────────────────────
# 優先順: R2 → Google Drive → ローカル(uploads/)
UPLOAD_DIR=uploads

# Cloudflare R2（未設定時はスキップ）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Drive（未設定時はスキップ）
# GOOGLE_DRIVE_TOKEN_JSON: ~/system_trade/config/KOTASAITO_drive_token.json の中身をそのまま貼り付け
GOOGLE_DRIVE_TOKEN_JSON=
# 作成済みフォルダID（2026-06-04 作成）
GOOGLE_DRIVE_DB_FOLDER_ID=19qxgONBY30xCDF7OBr_gUxuo1FL5Yktg
GOOGLE_DRIVE_UPLOADS_FOLDER_ID=10KXhTye1mWng4tItp5TVGQgKIhXKFHwm

# ─── メール通知（未設定時はコンソールログのみ） ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@digital-memorial.example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
